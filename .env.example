# Copy to `.env` and adjust as needed. Compose reads `.env` automatically.

# --- Backend ---
MAX_UPLOAD_MB=60
MAX_PIXELS_MP=200
CACHE_TTL_HOURS=24
CACHE_SWEEP_MINUTES=15
VIPS_THRESHOLD_MP=40
LOG_LEVEL=INFO
ALLOWED_ORIGINS=*
WEB_CONCURRENCY=4

# --- Ports exposed on host ---
FRONTEND_PORT=8080
BACKEND_PORT=8000

# --- Optional: Sentry ---
# SENTRY_DSN=

# --- PostHog (backend + frontend) ---
# Same project key on both sides; VITE_* vars are read at build time and
# baked into the frontend bundle.
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://eu.i.posthog.com
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://eu.i.posthog.com
